# Copy to .env and adjust. Never commit .env.
# Local development without Docker (SQLite):
MFE_DATABASE_URL=sqlite:///./app.db
MFE_MAX_BATCH_SIZE=100

# Used by docker-compose.yml only. Use a simple alphanumeric password
# (symbols would need URL-encoding inside the database URL).
POSTGRES_USER=mfe
POSTGRES_PASSWORD=change_me_to_something_simple
POSTGRES_DB=mfe